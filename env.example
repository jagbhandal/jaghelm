# ── JagHelm Configuration ──
# Every variable JagHelm reads is in this file (server/env.js is its schema).
# An empty line (`NAME=`) counts as unset. A value that doesn't fit its
# variable (LOG_LEVEL=loud) is warned once by name in the log and its default
# used; only a bad PORT or JAGHELM_BLOCK_PRIVATE_NETWORKS stops the start.
#
# PROMETHEUS_URL is the one address you need to get started (node data comes from
# it). Unset, the board says "Prometheus is not set" and nothing is requested.
# KUMA_URL is optional: set it only if you run Uptime Kuma. Unset, there is no
# Uptime Kuma and no error. Neither has a default.
# Use addresses the container can reach. Under the shipped compose.yaml
# (a bridge network) `localhost` is the JagHelm container itself, so give the
# host's LAN address or a hostname; `localhost` works only with
# `network_mode: host` or when running `npm start` on the same machine.
# No user, password or key in these URLs, nor in JAGHELM_GITEA_URL or any other
# *_URL below: one that carries a credential is refused and never used (put
# Kuma's key in KUMA_API_KEY, Gitea's token in JAGHELM_GITEA_TOKEN; JagHelm
# can't log in to Prometheus).
PROMETHEUS_URL=http://your-prometheus:9090
# KUMA_URL=http://your-kuma:3001

# Optional: Loki, for "Recent errors" in a node's or container's detail (the last
# 20 error-ish lines of 6 hours, read when the detail opens). Unset, the detail
# says logs aren't set up. No credential in the URL. Needs the labels `host`
# and `container_name` on the logs. `host` is the node's key in services.yaml;
# where Loki names a host differently, set `loki_host: <name>` on that node.
# Raw logs are shown only once a dashboard password is set.
LOKI_URL=

# Optional: Uptime Kuma API key (Kuma → Settings → API Keys). When set, JagHelm
# reads ALL monitors + 24h uptime from Kuma's authenticated /metrics endpoint in
# a single call — sees monitors that aren't on the status page, and paused
# monitors drop off automatically. Requires Uptime Kuma >= 2.1.0. Leave blank to
# use the public status-page API (the default; no key needed). The key is sent
# as an HTTP Basic header, so use an https:// KUMA_URL for any non-loopback host.
KUMA_API_KEY=

# Optional: Gitea for the dashboard's Pipeline panel, the recent commits on
# each repo's default branch, read every 5 minutes (a failed read is tried
# again after 30 seconds, then less often). Leave JAGHELM_GITEA_URL
# unset and JagHelm polls no Gitea and shows no Pipeline panel; there is no
# default address. In a bridge-network container, use an address the
# container can reach, not localhost. GITEA_URL and GITEA_TOKEN, the old
# names, still work for now; a later release drops them (the log warns once
# for each).
# The same pair also reads the Overview's "Pending host steps" (the open rows of
# homelab-infra issue #848, every 5 minutes, read-only): the token needs read
# access to that repo's issues. With either unset that section is absent.
JAGHELM_GITEA_URL=
JAGHELM_GITEA_TOKEN=

# The Expiry tracker's Tailscale node keys (#676, read-only, cached 6 hours) use
# the Tailscale integration's API key, JAGHELM_TAILSCALE_API_KEY (listed with the
# integrations below): an API access token from the Keys page of the Tailscale
# admin console. Tokens there are not scoped: they act with the role of the user
# who makes them, so create it as a user with a read-only role; it expires in 90 days at most, so renew it. With it unset, that
# source is absent. The tailnet defaults to the token's own ("-"); name it here
# only if you must. The TLS certificate targets are chosen in Settings, not here.
JAGHELM_TAILNET=

# Optional: the UPS the UPS panel shows, by its name in NUT (ups.conf, the
# exporter's `ups` label). Leave it unset and JagHelm shows the UPS the NUT
# exporter reports, the first by name when it reports several.
JAGHELM_UPS_NAME=

# Optional: the Backups section's B2 bucket size and trend (read-only, once a
# day in the background). Create a READ-ONLY application key restricted to the
# bucket in Backblaze (it needs listBuckets and listFiles). All three, or that
# part is absent; the key is never logged or shown.
JAGHELM_B2_KEY_ID=
JAGHELM_B2_APP_KEY=
JAGHELM_B2_BUCKET=

# Optional: drive health (SMART), read from smartctl_exporter series in
# Prometheus (docs/CONFIGURATION.md, docs/INTEGRATIONS.md). It is on wherever
# such series exist and absent where they don't. "off" turns it off even when
# they exist; on, or unset, leaves it to the series.
JAGHELM_DRIVES=

# Optional: Arcane update notifications (docs/arcane/SETUP.md). Off unless both
# ARCANE_URL and ARCANE_API_KEY are set. Use a read-only scoped key.
ARCANE_URL=
ARCANE_API_KEY=
# Comma list of environments Arcane only checks (every pending update counts as held back).
ARCANE_CHECK_ONLY_ENVS=
# Poll interval in seconds (default 300, minimum 60).
ARCANE_POLL_SECONDS=
# Arcane release check interval in hours (default 6, minimum 1).
ARCANE_RELEASE_CHECK_HOURS=
# How often Arcane's image watcher checks (its Polling schedule), in hours: the
# arcane-check job's expected interval (default 6, minimum 1, maximum 744).
ARCANE_IMAGE_CHECK_HOURS=
# Weekly vulnerability digest: comma list of environments to read (empty = off; the
# key's vulnerabilities:read grant is global in Arcane v2.16.1, so this list decides),
# then its slot in UTC: day 0 (Sunday) to 6, default 0; hour 0 to 23, default 14.
ARCANE_VULN_DIGEST_ENVS=
ARCANE_VULN_DIGEST_DAY=
ARCANE_VULN_DIGEST_HOUR=
# Trust a self-signed Arcane certificate, e.g. /app/data/arcane-ca.crt. Read at start.
NODE_EXTRA_CA_CERTS=

# Required for encrypted secrets (generate once: openssl rand -hex 32)
DASH_SECRET=your-random-secret-here

# Optional: Dashboard port
PORT=3099

# Optional: the address the server listens on (default 0.0.0.0, every IPv4
# interface). With network_mode: host, 127.0.0.1 keeps it to the host itself, for
# a reverse proxy there; a single LAN address would fail the image's health check,
# which calls localhost. In a bridge-network container keep the default: the
# published port arrives on the container's own interface, not on 127.0.0.1.
JAGHELM_HOST=

# Optional: Dashboard authentication (leave DASH_PASS empty to disable login)
DASH_USER=admin
DASH_PASS=

# Optional: the secret cron jobs send with POST /api/cron/report (docs/REPORTING.md,
# "Cron job reporting"). Unset, every report is refused.
# The same secret takes the hosts' config drift reports (POST /api/drift/report,
# docs/REPORTING.md "Config drift"); unset, the Overview has no Config drift row.
JAGHELM_CRON_SECRET=

# Optional: with no password set, the secrets API (/api/secrets), the log peek
# (/api/logs) and Remove on a missing container (/api/containers/forget) stay closed.
# "true" opens all of them anyway; only on a trusted, isolated LAN.
JAGHELM_ALLOW_OPEN_SECRETS=

# Optional: log level (debug|info|warn|error|silent; default info). debug adds the per-cycle lines
# and a line for every request (info logs only writes, 4xx/5xx and slow requests).
LOG_LEVEL=

# Optional: where JagHelm keeps its state (default data/ beside the app).
JAGHELM_DATA_DIR=

# Optional: the most the icon cache (icon-cache/ in the data dir) keeps, in MB
# (default 50). Past it the least recently used icon is deleted.
JAGHELM_ICON_CACHE_MAX_MB=

# Optional: alerts on the installed dashboard (the PWA), docs/GET-STARTED.md.
# Leave all three empty: JagHelm makes its own key pair at first start and
# keeps it in the data dir (vapid-keys.json, mode 0600; keep it in backups).
# Only to use your own pair: set BOTH keys (`node scripts/vapid-keys.mjs` in a
# checkout prints them); one without the other leaves Web Push off. The private
# key is a secret: never commit it. VAPID_SUBJECT is a contact the push services
# can reach (mailto: or https:); empty uses the project's GitHub page, so set
# your own address if you want the push services to reach YOU.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Server time zone for quiet hours when none is saved in Settings: give the
# container a TZ variable (a name such as America/Toronto; unset is UTC). It is
# not a JagHelm setting, so it is not listed as one here.

# ── Power-user overrides (optional) ──
# If set, these override the equivalent UI/yaml config.
# Most users should configure integrations via Settings UI instead.
# All integration env vars use the JAGHELM_ prefix to avoid
# colliding with service env vars in shared Docker networks.
# Each one without the prefix (NPM_URL, SONARR_API_KEY, …) is its old
# name: it still works for now, and the log warns once for it; a later
# release drops it.
# (JAGHELM_GITEA_URL and JAGHELM_GITEA_TOKEN, above, are the Gitea preset's too.)
#
# JAGHELM_ADGUARD_URL=http://192.168.x.x:8085
# JAGHELM_ADGUARD_USER=admin
# JAGHELM_ADGUARD_PASS=secret
#
# JAGHELM_NPM_URL=http://192.168.x.x:81
# JAGHELM_NPM_USER=admin@example.com
# JAGHELM_NPM_PASS=secret
#
# Every preset's variables:
#   Authentik      JAGHELM_AUTHENTIK_URL JAGHELM_AUTHENTIK_TOKEN
#   Bazarr         JAGHELM_BAZARR_URL JAGHELM_BAZARR_API_KEY
#   Caddy          JAGHELM_CADDY_URL
#   Cloudflare     JAGHELM_CLOUDFLARE_URL JAGHELM_CLOUDFLARE_TOKEN
#   Deluge         JAGHELM_DELUGE_URL JAGHELM_DELUGE_PASS
#   Emby           JAGHELM_EMBY_URL JAGHELM_EMBY_API_KEY
#   Frigate        JAGHELM_FRIGATE_URL
#   GitLab         JAGHELM_GITLAB_URL JAGHELM_GITLAB_TOKEN
#   Gotify         JAGHELM_GOTIFY_URL JAGHELM_GOTIFY_TOKEN
#   Home Assistant JAGHELM_HASS_URL JAGHELM_HASS_TOKEN
#   Immich         JAGHELM_IMMICH_URL JAGHELM_IMMICH_API_KEY
#   Jellyfin       JAGHELM_JELLYFIN_URL JAGHELM_JELLYFIN_API_KEY
#   Lidarr         JAGHELM_LIDARR_URL JAGHELM_LIDARR_API_KEY
#   Mealie         JAGHELM_MEALIE_URL JAGHELM_MEALIE_TOKEN
#   NextDNS        JAGHELM_NEXTDNS_URL JAGHELM_NEXTDNS_API_KEY
#   ntfy           JAGHELM_NTFY_URL
#   NZBGet         JAGHELM_NZBGET_URL JAGHELM_NZBGET_USER JAGHELM_NZBGET_PASS
#   Overseerr      JAGHELM_OVERSEERR_URL JAGHELM_OVERSEERR_API_KEY
#   Paperless      JAGHELM_PAPERLESS_URL JAGHELM_PAPERLESS_TOKEN
#   PhotoPrism     JAGHELM_PHOTOPRISM_URL JAGHELM_PHOTOPRISM_USER JAGHELM_PHOTOPRISM_PASS
#   Pi-hole        JAGHELM_PIHOLE_URL JAGHELM_PIHOLE_APP_PASSWORD
#   Plex           JAGHELM_PLEX_URL JAGHELM_PLEX_TOKEN
#   Portainer      JAGHELM_PORTAINER_URL JAGHELM_PORTAINER_USER JAGHELM_PORTAINER_PASS
#   Prowlarr       JAGHELM_PROWLARR_URL JAGHELM_PROWLARR_API_KEY
#   Proxmox        JAGHELM_PROXMOX_URL JAGHELM_PROXMOX_TOKEN
#   qBittorrent    JAGHELM_QBITTORRENT_URL JAGHELM_QBITTORRENT_USER JAGHELM_QBITTORRENT_PASS
#   Radarr         JAGHELM_RADARR_URL JAGHELM_RADARR_API_KEY
#   Readarr        JAGHELM_READARR_URL JAGHELM_READARR_API_KEY
#   SABnzbd        JAGHELM_SABNZBD_URL JAGHELM_SABNZBD_API_KEY
#   Sonarr         JAGHELM_SONARR_URL JAGHELM_SONARR_API_KEY
#   Speedtest      JAGHELM_SPEEDTEST_URL
#   Tailscale      JAGHELM_TAILSCALE_URL JAGHELM_TAILSCALE_API_KEY
#   Tautulli       JAGHELM_TAUTULLI_URL JAGHELM_TAUTULLI_API_KEY
#   Traefik        JAGHELM_TRAEFIK_URL
#   Transmission   JAGHELM_TRANSMISSION_URL JAGHELM_TRANSMISSION_USER JAGHELM_TRANSMISSION_PASS
#   Vaultwarden    JAGHELM_VAULTWARDEN_URL

# Reverse proxy IPs to trust X-Forwarded-For from. Comma-separated.
# Leave blank if JagHelm is exposed directly without a proxy.
# Common values:
#   - Single Nginx/Traefik/NPM:  192.168.x.x
#   - HA pair:                   192.168.x.10,192.168.x.11
#   - Express keywords:          loopback,linklocal,uniquelocal
TRUST_PROXY=

# Networks whose addresses never wait on the shared sign-in budget (#257).
# Comma-separated CIDRs or addresses, IPv4 and IPv6. Empty by default. During
# a sign-in attack from many addresses, a brand-new address can be kept out;
# addresses in these networks (and the last 16 you signed in from) get in.
# Their own failures still make them wait. Trust only networks whose devices
# you trust, and set TRUST_PROXY right first: with an X-Forwarded-For anyone
# can write, anyone can claim one of these addresses.
#   LOGIN_TRUSTED_NETS=192.168.68.0/22,100.64.0.0/10   (a LAN and Tailscale)
LOGIN_TRUSTED_NETS=

# Allow-listed CORS origins. Comma-separated, exact-match (scheme + host + port).
# Leave blank to block all cross-origin requests (the safe default — JagHelm
# serves its own SPA from the same origin).
#   CORS_ORIGIN=https://dash.example.com,https://lab.example.com
CORS_ORIGIN=

# SSRF guard strict mode. By default JagHelm allows private/loopback hosts
# (192.168/16, 10/8, 172.16/12, 127/8, localhost, fc00::/7) because they are
# the legitimate integration targets in a homelab. Cloud-metadata IPs
# (169.254.169.254) and 0.0.0.0 are always blocked.
#
# Set to "true" to additionally block all RFC1918/loopback/link-local/ULA
# targets — only appropriate for multi-tenant deployments where users
# shouldn't be able to point integrations at internal services.
JAGHELM_BLOCK_PRIVATE_NETWORKS=
# Content-Security-Policy: ENFORCING by default (strict script-src 'self' — the
# app's primary XSS containment). Set to "true" only to fall back to a
# report-only header while tuning a deploy that serves custom inline assets.
CSP_REPORT_ONLY=

# ── Tuning (optional; the defaults suit a 30 s refresh) ──
# A container counts as running while cAdvisor saw it this many seconds ago (90).
JAGHELM_CONTAINER_STALE_SEC=
# A Kuma monitor reporting down whose last heartbeat is older than this, in ms,
# reads as paused, not as an outage (600000, 10 minutes).
JAGHELM_MONITOR_STALE_MS=
# A container gone for less than this is not missing yet, in ms (90000).
JAGHELM_PRESENCE_GRACE_MS=
# A container gone for longer than this is forgotten, in ms (86400000, a day).
JAGHELM_PRESENCE_TTL_MS=
# A container must have run this long, in ms, before its going counts (60000).
JAGHELM_PRESENCE_ESTABLISH_MS=
# A container missing for this long, in ms, pages once (600000, 10 minutes). The
# card shows after the grace above; this longer wait keeps a recreate or a short
# restart from paging. Removing the card, Ack, Snooze and the 24 h fade end it.
JAGHELM_MISSING_PUSH_AFTER_MS=

# Read-only public demo (docs/DEMO.md). "true" serves a demo board from data
# built into the image: every write is refused, the server sends no request
# and writes no file. Never use it for a real dashboard.
# DEMO_SCENARIO picks the data: "incident" (the default: one service down, a
# failed backup job) or "healthy".
# DEMO_MODE=true
# DEMO_SCENARIO=incident
