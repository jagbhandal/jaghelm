# Dependencies — reinstalled by npm ci in the image
node_modules

# Local environment files — secrets must NEVER reach the image
# (env.example does NOT match these patterns and is intentionally included)
.env
.env.*
.npmrc

# Git + CI config — not needed at runtime
.git
.gitignore
.github
.gitea

# Editor / IDE
.vscode
.idea
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts — rebuilt by `npm run build` in the image
dist

# Persistent data — mounted as volumes
data
uploads

# Documentation — not needed at runtime
README.md
LICENSE
docs

# Tests and test-only fixtures — run in CI on the checkout, never inside the
# image build; nothing at runtime reads them (registry.js also refuses to load
# presets/*.test.js)
**/*.test.*
server/arcane/fixtures
server/routes/fixtures

# Arcane dry-run CLI (docs/arcane/SETUP.md §9) — a dev tool run from a checkout
# with `node scripts/arcane-poll-once.js`; the server never loads these
# (scripts/docker-image.test.mjs checks the import graph)
scripts/arcane-poll-once.js
server/arcane/pollOnce.js
server/arcane/projectFixture.js
server/arcane/vulnDigestOnce.js

# Archives
*.tar.gz