{
  "name": "jaghelm",
  "version": "3.0.0",
  "description": "JagHelm — Real-time infrastructure dashboard for homelabs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build && node scripts/inject-sw-precache.mjs",
    "start": "node server/index.js",
    "test": "node --import ./scripts/test-data-dir.mjs --import ./scripts/test-exit-guard.mjs --test --test-timeout=60000 \"server/**/*.test.{js,mjs,cjs}\" \"src/**/*.test.{js,mjs,cjs}\" \"scripts/**/*.test.{js,mjs,cjs}\"",
    "test:ci": "node scripts/test-floor.mjs npm test",
    "test:watch": "node --import ./scripts/test-data-dir.mjs --test --watch",
    "test:client": "vitest run",
    "test:client:watch": "vitest",
    "test:all": "npm test && npm run test:client",
    "gallery": "vite --open /gallery/",
    "gallery:test": "node scripts/gallery.mjs test",
    "gallery:update": "node scripts/gallery.mjs update",
    "test:e2e": "node scripts/gallery.mjs test --config playwright.e2e.config.mjs",
    "lint": "eslint .",
    "theme-bases": "node scripts/theme-bases.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:assets": "node scripts/check-assets.mjs",
    "secret-scan": "python3 scripts/secret-scan.py"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.0",
    "multer": "^2.2.0",
    "prom-client": "^15.1.3",
    "undici": "^8.12.3",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@base-ui/react": "^1.8.0",
    "@eslint/js": "^9.16.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-react": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.52.0",
    "playwright-core": "1.63.0",
    "postcss": "^8.5.25",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.0.0",
    "supertest": "^7.2.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^8.1.6",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
