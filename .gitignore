node_modules/
dist/
.env
uploads/
data/
# mobile/src/data/ is source code (derivation modules), not a data directory — negate
!mobile/src/data/
!mobile/src/data/**

# --- secrets (harness floor) — never commit credentials ---
# (Phase 0 hardened: web + mobile secret classes. Negations below keep templates tracked.)
.env.*
*.key
*.pem
*.p12
*.pfx
*.pkcs12
id_rsa
id_ed25519
*credential*
*-secret.json
*service-account*.json
.secrets/

# mobile / FCM secret classes (pre-empt Android + push creds)
*.jks
*.keystore
keystore.properties
google-services.json
GoogleService-Info.plist

# scratch dirs
.superpowers/

# Python bytecode (secret-scan.py + secret_rules.py generate these)
__pycache__/
*.pyc

# mobile build artifacts + native secrets (Phase 2)
mobile/dist/
mobile/node_modules/
mobile/android/app/build/
mobile/android/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/google-services.json
mobile/keystore.properties
mobile/android/key.properties

# --- template NEGATIONS — committed *.example / *.sample templates MUST stay tracked ---
# Broad first so it survives EVERY ignore glob above (incl. *service-account*.json,
# *credential*, *.pem). Git evaluates last-match-wins, so these negations come last.
!**/*.example
!**/*.sample
!.env.example
!.env.sample
# The FCM template is renamed so NO *service-account*.json glob can swallow it, AND
# it is double-protected by the *.example negation above. Keep BOTH belt + braces:
!fcm-service-account.json.example
!**/google-services.json.example

# Superpowers implementation plans are ephemeral build-scaffolding (the merged
# code is their realized form). Keep them on disk for resume, out of the repo.
# Design SPECS stay tracked (docs/superpowers/specs/) — durable design rationale.
docs/superpowers/plans/
