<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background — full-bleed indigo, no white anywhere.
     Used as @drawable/ic_launcher_background; the @color variant is also set
     to #6366f1 in values/ic_launcher_background.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:gradientRadius="200%"
        android:centerX="0.5"
        android:centerY="0.35"
        android:startColor="#818cf8"
        android:endColor="#6366f1"/>
</shape>
