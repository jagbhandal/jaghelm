node_modules/
dist/
# the component gallery's build and test output (docs/GALLERY.md), and the
# shell's browser tests' build (e2e/, playwright.e2e.config.mjs)
dist-gallery/
dist-e2e/
test-results/
data/
# src/phone/data/ (the phone screens' board) is source code, not a data
# directory. Negate the
# directories only, never what is in them: a file there is still judged by every
# rule, and the rules that keep secrets out all come after this negation, so a
# .env, a key or a build in them stays ignored (scripts/secret-floor.test.mjs).
!src/phone/data/
.env
uploads/

# --- secrets (harness floor) — never commit credentials ---
# (Phase 0 hardened: web + Firebase/Android secret classes, kept as guards. Negations below keep templates tracked.)
.env.*
*.key
*.pem
*.p12
*.pfx
*.pkcs12
id_rsa
id_ed25519
*credential*
# ...never a changelog fragment, whatever its card's words (#556)
!/changes/*.md
*-secret.json
*service-account*.json
.secrets/

# Firebase/Android secret classes: nothing here uses them since #659, kept so a key can't be committed by accident
*.jks
*.keystore
keystore.properties
google-services.json
GoogleService-Info.plist

# scratch dirs
.superpowers/

# Python bytecode (secret-scan.py + secret_rules.py generate these)
__pycache__/
*.pyc

# --- template NEGATIONS — committed *.example / *.sample templates MUST stay tracked ---
# Broad first so it survives EVERY ignore glob above (incl. *service-account*.json,
# *credential*, *.pem). Git evaluates last-match-wins, so these negations come last.
!**/*.example
!**/*.sample
!.env.example
!.env.sample
!**/google-services.json.example

# Superpowers implementation plans are ephemeral build-scaffolding (the merged
# code is their realized form). Keep them on disk for resume, out of the repo.
# Design SPECS stay tracked (docs/superpowers/specs/) — durable design rationale.
docs/superpowers/plans/

# a symlinked node_modules (worktrees) is a file, which "node_modules/" does not match
node_modules
