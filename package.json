{
  "name": "jaghelm",
  "version": "1.4.0",
  "description": "JagHelm — Real-time infrastructure dashboard for homelabs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build && node scripts/inject-sw-precache.mjs",
    "start": "node server/index.js",
    "test": "node --test --test-force-exit",
    "test:watch": "node --test --watch",
    "test:client": "vitest run",
    "test:client:watch": "vitest",
    "test:all": "npm test && npm run test:client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:assets": "node scripts/check-assets.mjs",
    "secret-scan": "python3 scripts/secret-scan.py"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.0",
    "multer": "^2.2.0",
    "prom-client": "^15.1.3",
    "undici": "^6.27.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@eslint/js": "^9.16.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.0.0",
    "supertest": "^7.2.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.1",
    "vitest": "^4.1.9"
  }
}
