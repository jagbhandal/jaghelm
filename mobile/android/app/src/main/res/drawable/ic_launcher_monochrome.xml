<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome adaptive icon layer — Android 13+ themed icons (API 33+).
     System applies a tint colour over this; keep shapes white / single-colour.
     Contains shield outline + helm wheel as the recognisable silhouette. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Outer shield path (outline only — no fill, the tint provides colour) -->
    <path
        android:pathData="M100,16 L166,42 Q170,44 170,48 L170,108 Q170,148 100,178 Q30,148 30,108 L30,48 Q30,44 34,42 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.15"/>
    <path
        android:pathData="M100,16 L166,42 Q170,44 170,48 L170,108 Q170,148 100,178 Q30,148 30,108 L30,48 Q30,44 34,42 Z"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"/>

    <!-- Helm wheel — solid white so system tint applies -->
    <!-- Hub -->
    <path
        android:pathData="M100,80 A12,12 0 1,0 100,104 A12,12 0 1,0 100,80 Z"
        android:fillColor="#FFFFFF"/>
    <!-- Cardinal spokes -->
    <path
        android:pathData="M98,80 L102,80 L102,50 L98,50 Z"
        android:fillColor="#FFFFFF"/>
    <path
        android:pathData="M98,104 L102,104 L102,134 L98,134 Z"
        android:fillColor="#FFFFFF"/>
    <path
        android:pathData="M88,90 L88,94 L58,94 L58,90 Z"
        android:fillColor="#FFFFFF"/>
    <path
        android:pathData="M112,90 L112,94 L142,94 L142,90 Z"
        android:fillColor="#FFFFFF"/>
    <!-- Outer ring -->
    <path
        android:pathData="M100,50 A42,42 0 1,0 100,134 A42,42 0 1,0 100,50 Z"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"/>
    <!-- Cardinal pegs -->
    <path
        android:pathData="M100,41 A7,7 0 1,0 100,55 A7,7 0 1,0 100,41 Z"
        android:fillColor="#FFFFFF"/>
    <path
        android:pathData="M100,129 A7,7 0 1,0 100,143 A7,7 0 1,0 100,129 Z"
        android:fillColor="#FFFFFF"/>
    <path
        android:pathData="M49,85 A7,7 0 1,0 49,99 A7,7 0 1,0 49,85 Z"
        android:fillColor="#FFFFFF"/>
    <path
        android:pathData="M137,85 A7,7 0 1,0 137,99 A7,7 0 1,0 137,85 Z"
        android:fillColor="#FFFFFF"/>
</vector>
